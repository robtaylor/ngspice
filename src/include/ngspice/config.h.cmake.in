#cmakedefine HAVE_ULIMIT 1

/* Define to 1 if you have the `utimes' function. */
#cmakedefine HAVE_UTIMES 1

/* Define to 1 if you have the `vfork' function. */
#cmakedefine HAVE_VFORK 1

/* Define to 1 if you have the `dl' library (-ldl). */
#cmakedefine HAVE_LIBDL 1

/* Have fft routines in libfftw3 */
#cmakedefine HAVE_LIBFFTW3 1

/* Define to 1 if you have the `m' library (-lm). */
#cmakedefine HAVE_LIBM 1

/* Define to 1 if you have the `pthread' library (-lpthread). */
#cmakedefine HAVE_LIBPTHREAD 1

/* Define to 1 if you have the `stdc++' library (-lstdc++). */
#cmakedefine HAVE_LIBSTDCXX 1

/* Have xft routines in libxft */
#cmakedefine HAVE_LIBXFT 1

/* Define to 1 if you have BSD editline */
#cmakedefine HAVE_BSDEDITLINE 1

/* Define to 1 if you have GNU readline */
#cmakedefine HAVE_GNUREADLINE 1

/* Define to 1 if you have termcap */
#cmakedefine HAVE_TERMCAP 1

/* Define to 1 if you have the ANSI C header files. */
#define STDC_HEADERS 1

/* The size of `int', as computed by sizeof. */
#define SIZEOF_INT @SIZEOF_INT@

/* The size of `long', as computed by sizeof. */
#define SIZEOF_LONG @SIZEOF_LONG@

/* The size of `void*', as computed by sizeof. */
#define SIZEOF_VOIDP @SIZEOF_VOIDP@

/* The size of `size_t', as computed by sizeof. */
#define SIZEOF_SIZE_T @SIZEOF_SIZE_T@

/* Define if we want KLU linear systems solver */
#cmakedefine KLU 1

/* Define if we want OpenMP parallel processing */
#cmakedefine USE_OMP 1

/* The CIDER enhancements */
#cmakedefine CIDER 1

/* The XSPICE enhancements */
#cmakedefine XSPICE 1

/* The OSDI enhancements */
#cmakedefine OSDI 1

/* The NDEV interface */
#cmakedefine NDEV 1

/* S parameter analysis */
#cmakedefine RFSPICE 1

/* Define if we want PSS analysis */
#cmakedefine WITH_PSS 1

/* Define if we want predictor algorithm */
#cmakedefine PREDICTOR 1

/* Define if we want NOBYPASS */
#cmakedefine NOBYPASS 1

/* Define if we want to bypass cbd/cbs calculation for non varying vbs/vbd */
#cmakedefine CAPBYPASS 1

/* Define if we want experimental code */
#cmakedefine EXPERIMENTAL_CODE 1

/* Define if we want to enable experimental devices */
#cmakedefine EXP_DEV 1

/* Define if we want to disable UNICODE support */
#cmakedefine EXT_ASC 1

/* Define if we want garbage collection enabled */
#cmakedefine HAVE_LIBGC 1

/* Internal (old) help not available */
#cmakedefine NOINTHELP 1

/* Define if you want to debug ngspice shell */
#cmakedefine CPDEBUG 1

/* Define if you want to debug frontend */
#cmakedefine FTEDEBUG 1

/* Compile with debug info */
#cmakedefine NGDEBUG 1

/* Define if X Window System is missing */
#cmakedefine X_DISPLAY_MISSING 1

/* Define if we want to compile for MS Windows */
#cmakedefine HAS_WINGUI 1

/* Define if shared ngspice module */
#cmakedefine SHARED_MODULE 1

/* Define if TCL module */
#cmakedefine TCL_MODULE 1

/* Define if we have relative paths for libraries and scripts */
#cmakedefine HAS_RELPATH 1

/* Define the operating system */
#cmakedefine OS_COMPILED @OS_COMPILED@

/* Define the directory for executables */
#cmakedefine NGSPICEBINDIR "@NGSPICEBINDIR@"

/* Define the directory for architecture independent data files */
#cmakedefine NGSPICEDATADIR "@NGSPICEDATADIR@"

/* Define the directory for architecture-dependent libraries */
#cmakedefine NGSPICELIBDIR "@NGSPICELIBDIR@"

/* Define the build date */
#cmakedefine NGSPICEBUILDDATE "@NGSPICEBUILDDATE@"

/* Package name */
#define PACKAGE_NAME "ngspice"

/* Package version */
#define PACKAGE_VERSION "@PROJECT_VERSION@"

/* Package string */
#define PACKAGE_STRING "ngspice @PROJECT_VERSION@"

/* Package bug report address */
#define PACKAGE_BUGREPORT "http://ngspice.sourceforge.net/bugrep.html"

/* Package URL */
#define PACKAGE_URL "https://ngspice.sourceforge.io"

/* Define to the version of this package. */
#define VERSION "@PROJECT_VERSION@"

#endif /* NGSPICE_CONFIG_H */