# ngspice-config.cmake.in - CMake configuration file for ngspice

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find dependencies
find_dependency(Threads)

# Feature-dependent dependencies
@NGSPICE_FIND_DEPENDENCIES@

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/ngspice-targets.cmake")

# Define variables for compatibility
set(NGSPICE_VERSION @PROJECT_VERSION@)
set(NGSPICE_LIBRARIES ngspice::ngspice)
set(NGSPICE_INCLUDE_DIRS "${CMAKE_CURRENT_LIST_DIR}/../../../include")

check_required_components(ngspice)